    "version": "0.2.0",
    "configurations": [
        {
            "name": "Shervice Flutter",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "args": [
                "--no-web-resources-cdn"
            ]
        },
        {
            "name": "Shervice Flutter (profile mode)",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--no-web-resources-cdn"
            ]
        },
        {
            "name": "Shervice Flutter (release mode)",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--no-web-resources-cdn"
            ]
        }
    ]
}
